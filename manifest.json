{
  "manifest_version": 3,
  "name": "Tab Volume Manager",
  "version": "1.0.0",
  "description": "各タブの音量を個別に増幅・コントロールし、サイトごとの音量設定を自動で保存・復元できるボリュームマネージャーです。",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Volume Control",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}